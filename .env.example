# Copy to .env and adjust. Never commit real secrets.
ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://pumpguard:pumpguard@localhost:5432/pumpguard
REDIS_URL=redis://localhost:6379/0
# synthetic = demo data generated locally (SYNTH_ symbols); yahoo = real NSE data via yfinance
DATA_SOURCE=synthetic
UNIVERSE_PATH=config/universe.yaml
BENCHMARK_PATH=data/benchmark/cases_template.csv
# none = deterministic template explainer (no key needed); openai = any OpenAI-compatible endpoint
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
DEFAULT_ALERT_THRESHOLD=90
API_URL=http://localhost:8000
